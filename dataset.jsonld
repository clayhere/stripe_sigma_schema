    },
    {
      "@type": "DataDownload",
      "name": "Agent context pack (Markdown)",
      "encodingFormat": "text/markdown",
      "contentUrl": "https://github.com/claysones/stripe-sigma-schema/blob/main/AGENTS.md"
    },
    {
      "@type": "DataDownload",
      "name": "Trino DDL",
      "encodingFormat": "application/sql",
      "contentUrl": "https://github.com/claysones/stripe-sigma-schema/blob/main/dist/sigma_schema.trino.sql"
    },
    {
      "@type": "DataDownload",
